# medFunnels → Integrations → New credential. Give it the analytics:write permission for funnel analytics.
# Server-side only: never prefix these with NEXT_PUBLIC_.
MEDFUNNELS_CLIENT_ID=mfc_…
MEDFUNNELS_CLIENT_SECRET=mfs_…

# Optional: a different medFunnels deployment (default https://www.medfunnels.app).
# MEDFUNNELS_API=https://medical-forms-ai-web.onrender.com

# Optional: the website this deployment serves, if your workspace locks releases to its websites.
# MEDFUNNELS_SITE_ORIGIN=https://demo.example.com

# Optional: the conversion name the plan page reports (register it in medFunnels → Analytics). Default "purchased".
# MEDFUNNELS_CONVERSION=purchased
